---
import { Image } from "astro:assets";

const { nombre, gancho, año, portada, portadaAlt, href } = Astro.props;
---

<li>
	<a href={href}>
		<Image
			src={portada}
			alt={portadaAlt}
			class="tarjeta-imagen"
			widths={[300, 600]}
			sizes="(min-width: 46rem) 20rem, 100vw"
		/>
		<div class="encabezado">
			<h3>{nombre}</h3>
			<span class="año">{año}</span>
		</div>
		<p class="gancho">{gancho}</p>
	</a>
</li>

<style>
	a {
		display: block;
		padding: 1.75rem;
		border: 1px solid var(--borde);
		border-radius: 0.75rem;
		text-decoration: none;
		color: inherit;
		background: #fff;
	}

	a:hover {
		border-color: var(--tinta);
	}

	.encabezado {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.5rem;
	}

	.gancho {
		color: var(--gris);
		margin: 0;
		font-size: 0.9375rem;
	}

	.año {
		font-size: 0.8125rem;
		color: var(--gris);
		flex-shrink: 0;
	}

	.tarjeta-imagen {
		width: 100%;
		height: 24rem;
		object-fit: cover;
		display: block;
		border-radius: 0.5rem;
		margin-bottom: 1rem;
	}
</style>
