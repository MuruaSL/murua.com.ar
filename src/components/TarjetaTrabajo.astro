---
const { nombre, gancho, descripcion, url, año } = Astro.props;
---

<li>
	<a href={url}>
		<div class="encabezado">
			<h3>{nombre}</h3>
			<span class="año">{año}</span>
		</div>
		<p class="gancho">{gancho}</p>
		<p class="descripcion">{descripcion}</p>
	</a>
</li>

<style>
	a {
		display: block;
		padding: 1.75rem;
		border: 1px solid var(--borde);
		border-radius: 0.75rem;
		text-decoration: none;
		color: inherit;
		background: #fff;
	}

	a:hover {
		border-color: var(--tinta);
	}

	.encabezado {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.5rem;
	}

	.gancho {
		margin-bottom: 0.5rem;
	}

	.descripcion {
		color: var(--gris);
		margin: 0;
		font-size: 0.9375rem;
	}

	.año {
		font-size: 0.8125rem;
		color: var(--gris);
		flex-shrink: 0;
	}
</style>
