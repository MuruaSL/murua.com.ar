---
const { titulo, descripcion, imagen = "/og.png" } = Astro.props;

const canonica = new URL(Astro.url.pathname, Astro.site);
const portada = new URL(imagen, Astro.site);
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<title>{titulo}</title>
		<meta name="description" content={descripcion} />
		<link rel="canonical" href={canonica} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Leonardo Murúa" />
		<meta property="og:locale" content="es_AR" />
		<meta property="og:title" content={titulo} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:url" content={canonica} />
		<meta property="og:image" content={portada} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="Leonardo Murúa · Desarrollo web · murua.com.ar"
		/>

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={titulo} />
		<meta name="twitter:description" content={descripcion} />
		<meta name="twitter:image" content={portada} />

		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Leonardo Murúa",
			"url": "https://murua.com.ar",
			"image": portada.toString(),
			"jobTitle": "Desarrollador web",
			"description": "Desarrollo sitios y aplicaciones web para negocios de Córdoba.",
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "Córdoba",
				"addressRegion": "Córdoba",
				"addressCountry": "AR",
			},
			"knowsAbout": ["Desarrollo web", "Astro", "JavaScript", "React"],
			"sameAs": ["https://github.com/MuruaSL"],
		})} />
	</head>

	<body>
		<main>
			<slot />
		</main>
	</body>
</html>

<style is:global>
	:root {
		--tinta: #16181d;
		--gris: #5b616e;
		--fondo: #fafaf9;
		--borde: #e6e5e2;
		--acento: #A45631;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		padding: 0 1.5rem;
		background: var(--fondo);
		color: var(--tinta);
		font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
		line-height: 1.65;
		-webkit-font-smoothing: antialiased;
	}

	main {
		max-width: 44rem;
		margin: 0 auto;
		padding: 6rem 0;
	}

	section + section {
		margin-top: 5rem;
	}

	h1 {
		font-size: clamp(2.5rem, 7vw, 3.5rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.1;
		margin: 0.5rem 0 1.25rem;
	}

	h2 {
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gris);
		margin: 0 0 1.25rem;
	}

	h3 {
		font-size: 1.125rem;
		font-weight: 600;
		margin: 0;
	}

	p {
		margin: 0 0 1rem;
		max-width: 38rem;
	}

	strong {
		font-weight: 600;
	}

	a {
		color: var(--acento);
	}

	a,
	.boton {
		transition: border-color 0.15s, background-color 0.15s;
	}

	:focus-visible {
		outline: 2px solid var(--acento);
		outline-offset: 2px;
		border-radius: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		* {
			transition: none !important;
		}
	}
</style>
