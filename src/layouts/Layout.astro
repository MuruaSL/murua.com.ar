---
const { titulo, descripcion } = Astro.props;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<title>{titulo}</title>
		<meta name="description" content={descripcion} />
	</head>

	<body>
		<main>
			<slot />
		</main>
	</body>
</html>

<style is:global>
	:root {
		--tinta: #16181d;
		--gris: #5b616e;
		--fondo: #fafaf9;
		--borde: #e6e5e2;
		--acento: #2563eb;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		padding: 0 1.5rem;
		background: var(--fondo);
		color: var(--tinta);
		font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
		line-height: 1.65;
		-webkit-font-smoothing: antialiased;
	}

	main {
		max-width: 44rem;
		margin: 0 auto;
		padding: 6rem 0;
	}

	section + section {
		margin-top: 5rem;
	}

	h1 {
		font-size: clamp(2.5rem, 7vw, 3.5rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.1;
		margin: 0.5rem 0 1.25rem;
	}

	h2 {
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gris);
		margin: 0 0 1.25rem;
	}

	h3 {
		font-size: 1.125rem;
		font-weight: 600;
		margin: 0;
	}

	p {
		margin: 0 0 1rem;
		max-width: 38rem;
	}

	strong {
		font-weight: 600;
	}

	a {
		color: var(--acento);
	}
</style>
