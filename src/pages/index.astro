---
const whatsapp = "https://wa.me/5493516996404";

const servicios = [
  {
    titulo: "Sitios para negocios",
    detalle:
      "Sitios institucionales para negocios y profesionales, y landing pages para un servicio, un producto o una campaña puntual.",
  },
  {
    titulo: "Aplicaciones a medida",
    detalle:
      "Aplicaciones web con usuarios, datos e integraciones con Google, calendarios y otros servicios. También sistemas internos para organizar o automatizar tareas.",
  },
  {
    titulo: "Mantenimiento y mejoras",
    detalle:
      "Actualización, corrección y mejora de sitios que ya están funcionando.",
  },
];

const trabajos = [
  {
    nombre: "Herrería WS Murúa",
    gancho: "Una presencia digital para mostrar el trabajo detrás del oficio.",
    descripcion:
      "Sitio institucional para un taller de herrería de Córdoba, desarrollado para presentar sus servicios, mostrar trabajos realizados y facilitar el contacto directo con potenciales clientes.",
    url: "https://herreria-ws-murua.vercel.app",
    año: "2022",
  },
  {
    nombre: "Kura",
    gancho: "Un lugar para guardar lo importante.",
    descripcion:
      "Aplicación web de organización personal multipropósito, desarrollada para centralizar distintas herramientas en un mismo espacio. Combina organización, calendario, finanzas, estudio y otras herramientas, con conexiones a Google y calendarios. Cuenta con usuarios, autenticación e información personalizada, y funciona completamente desde la web.",
    url: "https://mikura.vercel.app",
    año: "2025",
  },
];
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<title>Leonardo Murúa · Desarrollo web</title>
		<meta
			name="description"
			content="Desarrollo sitios y aplicaciones web en Córdoba. Webs rápidas, adaptadas al celular y pensadas para cumplir un objetivo."
		/>
	</head>

	<body>
		<main>
			<section class="hero">
				<p class="etiqueta">Desarrollo web</p>
				<h1>Leonardo Murúa</h1>
				<p class="bajada">
					Sitios y aplicaciones web, hechos para que tu negocio consiga clientes.
				</p>
				<p>
					Creo webs rápidas, adaptadas al celular y pensadas para cumplir un objetivo:
					mostrar tu negocio, conseguir consultas, ofrecer un servicio o resolver una
					necesidad específica.
				</p>
				<p>
					Trabajo directamente con cada cliente, desde la idea inicial hasta la puesta
					en marcha.
				</p>
				<a class="boton" href={whatsapp}>Escribime por WhatsApp</a>
			</section>

			<section>
				<h2>Qué puedo hacer por vos</h2>
				<p>
					Cada proyecto necesita una solución diferente. Puedo desarrollar desde una
					página simple para presentar un negocio hasta una aplicación web completa con
					usuarios, datos, integraciones y herramientas a medida.
				</p>
				<ul class="servicios">
					{servicios.map((servicio) => (
						<li>
							<h3>{servicio.titulo}</h3>
							<p>{servicio.detalle}</p>
						</li>
					))}
				</ul>
				<p class="cierre">
					La idea no es hacer una web porque sí. Es construir algo que realmente te sea
					útil.
				</p>
			</section>

			<section>
				<h2>Trabajos</h2>
				<ul class="trabajos">
					{trabajos.map((trabajo) => (
						<li>
							<a href={trabajo.url}>
								<div class="encabezado">
									<h3>{trabajo.nombre}</h3>
									<span class="año">{trabajo.año}</span>
								</div>
								<p class="gancho">{trabajo.gancho}</p>
								<p>{trabajo.descripcion}</p>
							</a>
						</li>
					))}
				</ul>
			</section>

			<section>
				<h2>Sobre mí</h2>
				<p>
					Soy desarrollador web, formado en Coderhouse y estudiante de Ingeniería en
					Sistemas de Información en la UTN Facultad Regional Córdoba.
				</p>
				<p>
					Trabajo <strong>full stack</strong>: me ocupo tanto de lo que se ve —el diseño
					y la navegación— como de lo que funciona por detrás —usuarios, datos,
					integraciones—. Para vos eso significa una sola persona a cargo del proyecto
					entero, sin coordinar entre varios.
				</p>
				<p>
					Me interesa construir productos que no solamente funcionen, sino que sean
					claros, útiles y fáciles de usar. Busco entender primero qué necesita el
					proyecto y después elegir la mejor forma de construirlo.
				</p>
			</section>

			<section>
				<h2>Contacto</h2>
				<p class="pregunta">¿Tenés una idea o necesitás una web?</p>
				<p>
					Contame qué necesitás. Podemos hablar del proyecto, pensar la solución y ver
					juntos cómo llevarla a la web.
				</p>
				<p>
					WhatsApp: <a href={whatsapp}>+54 9 351 699-6404</a>
				</p>
			</section>
		</main>
	</body>
</html>

<style>
	:root {
		--tinta: #16181d;
		--gris: #5b616e;
		--fondo: #fafaf9;
		--borde: #e6e5e2;
		--acento: #2563eb;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		padding: 0 1.5rem;
		background: var(--fondo);
		color: var(--tinta);
		font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
		line-height: 1.65;
		-webkit-font-smoothing: antialiased;
	}

	main {
		max-width: 44rem;
		margin: 0 auto;
		padding: 6rem 0;
	}

	section + section {
		margin-top: 5rem;
	}

	h1 {
		font-size: clamp(2.5rem, 7vw, 3.5rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.1;
		margin: 0.5rem 0 1.25rem;
	}

	h2 {
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gris);
		margin: 0 0 1.25rem;
	}

	h3 {
		font-size: 1.125rem;
		font-weight: 600;
		margin: 0;
	}

	p {
		margin: 0 0 1rem;
		max-width: 38rem;
	}

	.etiqueta {
		font-size: 0.8125rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--gris);
		margin: 0;
	}

	.bajada {
		font-size: 1.375rem;
		line-height: 1.45;
		max-width: 32rem;
		margin-bottom: 1.5rem;
	}

	.hero p:not(.bajada):not(.etiqueta) {
		color: var(--gris);
	}

	.boton {
		display: inline-block;
		margin-top: 0.75rem;
		padding: 0.75rem 1.25rem;
		background: var(--tinta);
		color: var(--fondo);
		text-decoration: none;
		border-radius: 0.5rem;
		font-size: 0.9375rem;
	}

	.boton:hover {
		background: var(--acento);
	}

	.servicios {
		margin: 0 0 2rem;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 1.75rem;
	}

	.servicios li {
		padding-top: 1.25rem;
		border-top: 1px solid var(--borde);
	}

	.servicios h3 {
		margin-bottom: 0.35rem;
	}

	.servicios p {
		color: var(--gris);
		margin: 0;
		font-size: 0.9375rem;
		max-width: 34rem;
	}

	@media (min-width: 46rem) {
		.servicios {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.5rem;
		}
	}

	.cierre {
		border-left: 2px solid var(--borde);
		padding-left: 1rem;
	}

	.trabajos {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
	}

	.trabajos a {
		display: block;
		padding: 1.75rem;
		border: 1px solid var(--borde);
		border-radius: 0.75rem;
		text-decoration: none;
		color: inherit;
		background: #fff;
	}

	.trabajos a:hover {
		border-color: var(--tinta);
	}

	.encabezado {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.5rem;
	}

	.gancho {
		color: var(--tinta);
		margin-bottom: 0.5rem;
	}

	.trabajos p:not(.gancho) {
		color: var(--gris);
		margin: 0;
		font-size: 0.9375rem;
	}

	.año {
		font-size: 0.8125rem;
		color: var(--gris);
		flex-shrink: 0;
	}

	.pregunta {
		font-size: 1.25rem;
	}

	strong {
		font-weight: 600;
	}

	a {
		color: var(--acento);
	}
</style>
